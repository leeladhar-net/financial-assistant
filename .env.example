# App Environment & Mode
ENVIRONMENT=development
DEMO_MODE=true
LOG_LEVEL=INFO

# Telegram Configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_WEBHOOK_URL=https://your-domain.com/api/v1/telegram/webhook
TELEGRAM_WEBHOOK_SECRET=your_secret_token_here

# Database Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/financial_assistant
# For asyncpg: postgresql+asyncpg://postgres:postgres@localhost:5432/financial_assistant

# Redis Configuration (For Future Background Jobs / Cache)
REDIS_URL=redis://localhost:6379/0

# LLM & AI Credentials (Optional for Part 1 DEMO_MODE)
LLM_API_KEY=
LLM_PROVIDER=openai
